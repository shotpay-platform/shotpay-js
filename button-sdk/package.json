{
    "name": "@shotpay/button",
    "version": "0.1.2",
    "description": "Browser-side ShotPay button: asks your server to open a checkout session and redirects the customer. Never holds ShotPay credentials.",
    "keywords": [
        "shotpay",
        "payments",
        "checkout",
        "button",
        "react",
        "browser"
    ],
    "license": "MIT",
    "author": "ShotPay",
    "homepage": "https://app.shotpay.com/docs/",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./react": {
            "types": "./dist/react.d.ts",
            "import": "./dist/react.js",
            "require": "./dist/react.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "scripts": {
        "build": "tsup src/index.ts src/react.tsx --format esm,cjs --dts",
        "test": "vitest run",
        "prepublishOnly": "npm test && npm run build"
    },
    "peerDependencies": {
        "react": "^19.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@testing-library/react": "^16.3.0",
        "@types/node": "^22.0.0",
        "@types/react": "^19.0.0",
        "jsdom": "^26.0.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.7.0",
        "vitest": "^3.0.0"
    }
}
