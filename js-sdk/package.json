{
    "name": "@shotpay/node",
    "version": "0.3.0",
    "description": "JS/TS client for the ShotPay API: open and retrieve checkout sessions, work your layaway contracts, and verify inbound webhook signatures.",
    "keywords": [
        "shotpay",
        "payments",
        "checkout",
        "contracts",
        "webhooks",
        "sdk",
        "typescript"
    ],
    "license": "MIT",
    "author": "ShotPay",
    "homepage": "https://app.shotpay.com/docs/",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18"
    },
    "publishConfig": {
        "access": "public"
    },
    "sideEffects": false,
    "scripts": {
        "build": "tsup src/index.ts --format esm,cjs --dts --clean",
        "test": "vitest run",
        "prepublishOnly": "npm test && npm run build"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.7.0",
        "tsup": "^8.0.0",
        "vitest": "^3.0.0"
    }
}
