{
    "name": "@shotpay/sdk",
    "version": "0.1.0",
    "description": "Minimal JS/TS client for the ShotPay Checkout API: open and retrieve checkout sessions, and verify inbound webhook signatures.",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "tsup src/index.ts --format esm,cjs --dts",
        "test": "vitest run"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "typescript": "^5.7.0",
        "tsup": "^8.0.0",
        "vitest": "^3.0.0"
    }
}
